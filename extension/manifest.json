{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "Subscription Hub Usage Tracker",
  "version": "1.1.0",
  "description": "Automatically measures foreground time on the subscription websites you choose.",
  "permissions": [
    "storage",
    "alarms",
    "idle"
  ],
  "host_permissions": [
    "https://subscription-hub-rep.vercel.app/*"
  ],
  "optional_host_permissions": [
    "https://*.netflix.com/*",
    "https://open.spotify.com/*",
    "https://*.canva.com/*",
    "https://*.youtube.com/*",
    "https://*.primevideo.com/*",
    "https://*.chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Subscription Hub usage"
  },
  "incognito": "not_allowed"
}
